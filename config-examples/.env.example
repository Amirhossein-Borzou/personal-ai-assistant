# Example environment file — copy to .env and fill in REAL values there.
# .env is gitignored and must never leave the machine.

# --- model provider ---
LLM_API_KEY=sk-...

# --- telegram gateway (demo profile gets its OWN bot token from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456:ABC-...

# --- google integrations (OAuth) ---
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# --- stock watchdog skill (see skills/stock-watchdog) ---
WATCH_SYMBOL=NVDA
WATCH_DROP_PCT=3.5
WATCH_TOTAL_PCT=5.0
